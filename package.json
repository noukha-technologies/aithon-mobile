    "ios:stg": "cross-env ENVFILE=.env.staging react-native run-ios --scheme staging",
    "ios:prod": "cross-env ENVFILE=.env.production react-native run-ios --scheme production",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "icons": "node scripts/updateAppIcon.js",
    "fcm:server": "node scripts/fcm-tester/server.js",
    "postinstall": "patch-package"
  },
