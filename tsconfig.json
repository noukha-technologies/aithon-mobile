{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets": ["src/assets"],
      "@assets/*": ["src/assets/*"],
      "@config": ["src/config"],
      "@config/*": ["src/config/*"],
      "@models": ["src/models"],
      "@models/*": ["src/models/*"],
      "@views": ["src/views"],
      "@views/*": ["src/views/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"],
      "@hooks": ["src/hooks"],
      "@hooks/*": ["src/hooks/*"],
      "@api": ["src/api"],
      "@api/*": ["src/api/*"],
      "@screens": ["src/views/screens"],
      "@screens/*": ["src/views/screens/*"],
      "@components": ["src/views/components"],
      "@components/*": ["src/views/components/*"],
      "@navigation": ["src/navigation"],
      "@navigation/*": ["src/navigation/*"],
      "@constants": ["src/enums"],
      "@constants/*": ["src/enums/*"],
      "@theme": ["src/theme"],
      "@theme/*": ["src/theme/*"],
      "@redux": ["src/redux"],
      "@redux/*": ["src/redux/*"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
